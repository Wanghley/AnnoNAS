# Linux-Voice-Assistant - Docker Environment Configuration
# Copy this file to .env and customize for your setup by 'cp .env.example .env'

### Docker target platform:
# Orange Pi 3B+ is ARM64
DOCKER_PLATFORM="linux/arm64"

### Enable debug mode (optional):
# ENABLE_DEBUG="1"

### List audio devices (optional):
# if enabled normal startup is disabled
# LIST_DEVICES="1"

### User ID:
# Must match the host user running Docker (orangepi = 1000).
# Used for volume permissions and PulseAudio socket access.
LVA_USER_ID="1000"
LVA_USER_GROUP="1000"

### Name for the client (optional):
CLIENT_NAME="speaker_orangepi_on_rack"

### Sound backend:
# The container has NO internal PulseAudio daemon.
# It connects to the host PulseAudio socket mounted at /run/user/1000/pulse.
#
# PREREQUISITE — run once on the host before deploying:
#   sudo loginctl enable-linger orangepi
#   systemctl --user unmask pulseaudio.service pulseaudio.socket
#   systemctl --user enable --now pulseaudio
#   ls /run/user/1000/pulse/   # must show: cookie  native  pid
#
# Keep backend as "pulse". Do NOT use "alsa" — PulseAudio owns the ALSA
# device; direct hw:X,Y access would fail with "device busy".
LVA_SOUNDCARD_BACKEND="pulse"

### Audio output device:
# Must use the "pulse/<sink-name>" format for libmpv to route through PulseAudio.
# Find your sink name with:   pactl list sinks short
# Then prefix it with "pulse/"
#
# Example (MV-SILICON P10S USB speaker on this host):
AUDIO_OUTPUT_DEVICE="pulse/alsa_output.usb-MV-SILICON_P10S_202403221-00.analog-stereo"

### Audio input device:
# The soundcard Python library uses the bare PulseAudio source name (no "pulse/" prefix).
# Find your source name with:   pactl list sources short
#
# Example (MV-SILICON P10S USB mic on this host):
AUDIO_INPUT_DEVICE="alsa_input.usb-MV-SILICON_P10S_202403221-00.analog-stereo"

### Enable thinking sound (optional):
ENABLE_THINKING_SOUND="1"

### Path to the preferences file (optional):
# PREFERENCES_FILE="/app/configuration/preferences.json"

### Network interface (optional):
# NETWORK_INTERFACE="eth0"

### IP-Address for the api (optional):
# HOST="0.0.0.0"

### Port for the api (optional):
# PORT="6053"

### Wake word directory (optional):
# path for custom files in docker is for example "app/wakewords/custom"
# WAKE_WORD_DIR="app/wakewords"

### Wake model (optional):
# WAKE_MODEL="okay_nabu"

### Stop model (optional):
# STOP_MODEL="stop"

### Refactory seconds (optional):
# REFACTORY_SECONDS="2"

### Sound files (optional):
# path for custom files in docker is for example "sounds/custom/your_soundfile.flac"
# WAKEUP_SOUND="sounds/wake_word_triggered.flac"
# TIMER_FINISHED_SOUND="sounds/timer_finished.flac"
# PROCESSING_SOUND="sounds/processing.wav"
# MUTE_SOUND="sounds/mute_switch_on.flac"
# UNMUTE_SOUND="sounds/mute_switch_off.flac"
