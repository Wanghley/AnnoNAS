    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 29 },
      "id": 102, "panels": [],
      "title": "🐳  Containers", "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "left",
            "cellOptions": { "type": "auto" },
            "inspect": false, "minWidth": 80
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Memory" },
            "properties": [
              { "id": "unit", "value": "bytes" },
              { "id": "custom.width", "value": 120 },
              {
                "id": "custom.cellOptions",
                "value": { "mode": "gradient", "type": "gauge", "valueDisplayMode": "text" }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green",  "value": null          },
                    { "color": "yellow", "value": 536870912     },
                    { "color": "orange", "value": 1073741824    },
                    { "color": "red",    "value": 2147483648    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Node" },
            "properties": [{ "id": "custom.width", "value": 110 }]
          },
          {
            "matcher": { "id": "byName", "options": "Container" },
            "properties": [{ "id": "custom.width", "value": 220 }]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 30 },
      "id": 13,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Memory" }]
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sort_desc(sum by (job, name) (container_memory_working_set_bytes{job=~\"orin|app-server|gateway|nas\",name!=\"\",name!~\".+POD.+\"}))",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true, "__name__": true, "instance": true
            },
            "indexByName": { "job": 0, "name": 1, "Value": 2 },
            "renameByName": {
              "job":   "Node",
              "name":  "Container",
              "Value": "Memory"
            }
          }
        }
      ],
      "title": "Running Containers — Memory (Working Set)", "type": "table"
    },

