{
  "title": "AnnoGrid Container Topology",
  "uid": "annogrid-topology-v2",
  "schemaVersion": 38,
  "refresh": "30s",
  "tags": ["annogrid", "topology"],
  "time": { "from": "now-5m", "to": "now" },
  "panels": [
    {
      "type": "nodeGraph",
      "title": "AnnoGrid Container Topology",
      "gridPos": { "h": 24, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "Nodes",
          "expr": "last_over_time(annogrid_topology_node{id=~\"($host)(/.*)?\"} [2m])",
          "format": "table",
          "instant": true,
          "legendFormat": ""
        },
        {
          "refId": "Edges",
          "expr": "last_over_time(annogrid_topology_edge{source_node=~\"$host\",target_node=~\"$host\",network=~\"($network)|host\"}[2m])",
          "format": "table",
          "instant": true,
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "arc__host" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#aaaaaa" } }]
          },
          {
            "matcher": { "id": "byName", "options": "arc__opi3b" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#5794F2" } }]
          },
          {
            "matcher": { "id": "byName", "options": "arc__nas" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#73BF69" } }]
          },
          {
            "matcher": { "id": "byName", "options": "arc__gateway" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#FF9830" } }]
          },
          {
            "matcher": { "id": "byName", "options": "arc__orin" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#B877D9" } }]
          },
          {
            "matcher": { "id": "byName", "options": "arc__rpi4" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#FADE2A" } }]
          },
          {
            "matcher": { "id": "byName", "options": "arc__rpi5" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#F2495C" } }]
          },
          {
            "matcher": { "id": "byName", "options": "arc__x86" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#64B0EB" } }]
          }
        ]
      },
      "options": {
        "nodes": {
          "mainStatUnit": "short",
          "arcs": [
            { "field": "arc__host",    "color": "#aaaaaa" },
            { "field": "arc__opi3b",   "color": "#5794F2" },
            { "field": "arc__nas",     "color": "#73BF69" },
            { "field": "arc__gateway", "color": "#FF9830" },
            { "field": "arc__orin",    "color": "#B877D9" },
            { "field": "arc__rpi4",    "color": "#FADE2A" },
            { "field": "arc__rpi5",    "color": "#F2495C" },
            { "field": "arc__x86",     "color": "#64B0EB" }
          ]
        },
        "edges": {}
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "pluginId": "prometheus",
        "label": "Datasource",
        "current": {},
        "hide": 0
      },
      {
        "name": "host",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": {
          "query": "label_values(annogrid_topology_node{arc__host=\"1\"}, id)",
          "refId": "StandardVariableQuery"
        },
        "label": "Host",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {},
        "hide": 0,
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "network",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": {
          "query": "label_values(annogrid_topology_edge{network!=\"host\"}, network)",
          "refId": "StandardVariableQuery"
        },
        "label": "Docker Network",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {},
        "hide": 0,
        "refresh": 2,
        "sort": 1
      }
    ]
  }
}
