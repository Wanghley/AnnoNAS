# Encoded password: & -> %26 | # -> %23 | $ -> %24
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/litellm

# LiteLLM Admin Settings
LITELLM_MASTER_KEY=sk-<key>
UI_PASSWORD=<pass>
LITELLM_PORT=4001

# Open WebUI Settings
OPEN_WEBUI_PORT=8080
WEBUI_SECRET_KEY=<generate with: python3 -c "import secrets; print(secrets.token_hex(32))">

# Ollama endpoint (default works with docker-compose extra_hosts; use http://localhost:11434 for --network host)
OLLAMA_BASE_URL=http://host.docker.internal:11434
