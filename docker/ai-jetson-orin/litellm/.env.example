# Encoded password: & -> %26 | # -> %23 | $ -> %24
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/litellm

# LiteLLM Admin Settings
LITELLM_MASTER_KEY=sk-<key>
UI_PASSWORD=<pass>
LITELLM_PORT=4001

# Open WebUI Settings
OPEN_WEBUI_PORT=8080
WEBUI_SECRET_KEY=<generate with: python3 -c "import secrets; print(secrets.token_hex(32))">

# Ollama endpoint (default works with docker-compose extra_hosts; use http://localhost:11434 for --network host)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ── Cloud Provider API Keys ─────────────────────────────────────
# Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=<your-google-ai-studio-key>

# OpenRouter (access 200+ models via one key): https://openrouter.ai/keys
OPENROUTER_API_KEY=<your-openrouter-key>

# ── Redis (shared state: rate limits, budgets, router) ─────────
# Uses the core-data Redis on the app server; password lives in
# docker/application-server/core-data/.env on that host
REDIS_HOST=100.67.194.10
REDIS_PORT=6379
REDIS_PASSWORD=<same as core-data REDIS_PASSWORD>

# ── Global Budget Cap ───────────────────────────────────────────
# Hard stop when cumulative cloud spend hits this (USD, resets monthly)
LITELLM_MAX_BUDGET=20
