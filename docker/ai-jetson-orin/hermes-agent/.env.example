# Gateway API auth token — clients must send this as a Bearer token
# Generate with: openssl rand -hex 32
API_SERVER_KEY=<generate-with-openssl-rand-hex-32>

# Host ports
HERMES_API_PORT=8642
HERMES_DASHBOARD_PORT=9119

# Match your host user so files written under ./data aren't root-owned
HERMES_UID=1000
HERMES_GID=1000
