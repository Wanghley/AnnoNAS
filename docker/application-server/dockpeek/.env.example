# -------------------------------------------------------
# dockpeek — environment config
# Copy this file to .env (same folder as docker-compose.yml)
# and fill in real values. Never commit the real .env.
# -------------------------------------------------------

# Flask session secret — generate with: openssl rand -hex 32
DOCKPEEK_SECRET_KEY=replace-with-output-of-openssl-rand-hex-32

# Login credentials for the dockpeek web UI
DOCKPEEK_USERNAME=admin
DOCKPEEK_PASSWORD=replace-with-a-strong-password

# Optional: name shown in the UI for this host (auto-detected if left blank)
DOCKPEEK_HOST_NAME=AnnoGrid App Server
