# ==============================================================================
# Peekaping Stack - Environment Configuration Template
# ==============================================================================

# Database Target (Points to your external core Postgres container)
PEEKAPING_DB_HOST=postgres
PEEKAPING_DB_PORT=5432
PEEKAPING_DB_NAME=peekaping
PEEKAPING_DB_USER=peekaping_user
PEEKAPING_DB_PASSWORD=your_fallback_strong_password_here

# Global Container Engine Settings
TZ=America/New_York
