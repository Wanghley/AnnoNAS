# -------------------------------------------------------
# homarr — environment config
# Copy this file to .env (same folder as docker-compose.yml)
# and fill in real values. Never commit the real .env.
# -------------------------------------------------------

# Encryption key — generate with: openssl rand -hex 32
# Must be exactly 64 hex characters (32 bytes)
HOMARR_SECRET_KEY=replace-with-output-of-openssl-rand-hex-32

# Timezone
TZ=America/Sao_Paulo

# PostgreSQL credentials — must match docker-compose.db.yml
# The 'homarr' database must exist; see configs/postgres/init-scripts/init.sql
POSTGRES_USER=annogrid
POSTGRES_PASSWORD=replace-with-your-postgres-password
