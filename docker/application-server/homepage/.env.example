# -------------------------------------------------------
# homepage — environment config
# Copy this file to .env (same folder as docker-compose.yml)
# and fill in real values. Never commit the real .env.
# -------------------------------------------------------

TZ=America/Sao_Paulo

# --- Portainer ---
# Generate in Portainer: Account Settings → Access Tokens
HOMEPAGE_VAR_PORTAINER_KEY=replace-with-portainer-api-token

# --- Jellyfin ---
# Generate in Jellyfin: Dashboard → API Keys → +
HOMEPAGE_VAR_JELLYFIN_KEY=replace-with-jellyfin-api-key

# --- Grafana ---
# Use a read-only Grafana account or admin credentials
HOMEPAGE_VAR_GRAFANA_USER=admin
HOMEPAGE_VAR_GRAFANA_PASS=replace-with-grafana-password

# --- AI node service ports (from docker/ai-jetson-orin/litellm/.env) ---
HOMEPAGE_VAR_LITELLM_PORT=4000
HOMEPAGE_VAR_OPEN_WEBUI_PORT=8080

# NOTE: If services on remote nodes are unreachable by hostname,
# replace *.local hostnames in config/services.yaml with static IPs.
